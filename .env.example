# ==============================================================================
# UMA Market — Environment Variables Template
# Copy this file to `.env.local` and populate with your own credentials.
# NEVER commit `.env.local` or any secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Clerk Authentication
# Obtain these from: https://dashboard.clerk.com -> API Keys
#
# DEVELOPMENT: Uses pk_test_ / sk_test_ keys from your Development instance.
# PRODUCTION:  Uses pk_live_ / sk_live_ keys from your Production instance.
#              Set these per-environment in Vercel Dashboard → Settings → Env Vars.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Clerk Auth Route Handlers
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ------------------------------------------------------------------------------
# Supabase Database & API
# Obtain these from: https://supabase.com/dashboard/project/<ref>/settings/api
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (Client-side safe, enforces Row-Level Security)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here

# Secret key (SERVER-ONLY, administrative operations, bypasses RLS)
# WARNING: Never expose this key in client-side code or browser bundles.
# In Vercel, set this as a "Secret" type variable (write-only after save).
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# ------------------------------------------------------------------------------
# Clerk Webhooks
# Signing secret from Clerk Dashboard -> Webhooks -> Endpoint -> Signing Secret
# Required in production; used by verifyWebhook() to authenticate webhook events.
#
# IMPORTANT: Production and Development use DIFFERENT webhook signing secrets.
# Each Clerk instance (dev vs. prod) has its own webhook endpoints.
# ------------------------------------------------------------------------------
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_webhook_signing_secret_here

# ------------------------------------------------------------------------------
# Application URL (Production only)
# Used for metadataBase, canonical URLs, and OpenGraph resolution.
# In development, defaults to http://localhost:3000.
# Set in Vercel Production environment to https://yourdomain.com.
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
